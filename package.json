{
  "name": "stolarnia-online",
  "version": "0.1.0",
  "private": true,
  "description": "Stolarnia Online — serwer MCP i aplikacja web do projektowania, wyceny i produkcji mebli (port domeny z StolarniaApp).",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "mcp": "tsx src/mcp/stdio.ts",
    "mcp:build": "node dist/mcp/stdio.js",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "dxf-parser": "^1.1.2",
    "express": "^4.21.2",
    "pdfkit": "^0.20.2",
    "three": "^0.186.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
