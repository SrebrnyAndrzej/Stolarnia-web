{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build && node scripts/kopiuj-zasoby-vercel.mjs",
  "outputDirectory": "dist/web",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{src/export/assets/**,dist/*.js,dist/{core,export,mcp,server,store}/**,docs/materialy/*-PL.json,docs/okucia/produkty/katalog.json,node_modules/dejavu-fonts-ttf/package.json,node_modules/dejavu-fonts-ttf/ttf/DejaVuSans*.ttf}"
    }
  },
  "rewrites": [
    { "source": "/api/:sciezka*", "destination": "/api/index.js" },
    { "source": "/mcp", "destination": "/api/index.js" }
  ]
}
