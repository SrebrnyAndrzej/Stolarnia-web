[Unit]
Description=Pan Stolarz web and API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=panstolarz
Group=panstolarz
WorkingDirectory=/srv/pan-stolarz/current
Environment=NODE_ENV=production
Environment=PORT=3210
Environment=STOLARNIA_DATA=/var/lib/pan-stolarz
EnvironmentFile=/etc/pan-stolarz/app.env
ExecStartPre=/usr/bin/node deploy/ovh/preflight.mjs
ExecStart=/usr/bin/node dist/server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pan-stolarz
UMask=0077

[Install]
WantedBy=multi-user.target
