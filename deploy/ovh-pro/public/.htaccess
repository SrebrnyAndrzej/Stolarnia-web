Options -Indexes
RewriteEngine On
# Keep source/configuration files out of public access, including Git deployment metadata.
RewriteRule (^|/)(\.git|\.env)(/|$|\.) - [F,L]
# Canonical site origin is also used by the existing API's CSRF checks.
RewriteCond %{HTTP_HOST} ^www\.panstolarz\.pro$ [NC]
RewriteRule ^ https://panstolarz.pro%{REQUEST_URI} [R=302,L]
# Use HTTPS on the public preview; browser crypto APIs require a secure context.
RewriteCond %{HTTP_HOST} ^podglad\.panstolarz\.pro$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://podglad.panstolarz.pro%{REQUEST_URI} [R=302,L]
# Require HTTPS on the production domain.
RewriteCond %{HTTP_HOST} ^panstolarz\.pro$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://panstolarz.pro%{REQUEST_URI} [R=302,L]
# Static catalog images are served directly; dynamic API uses the fixed PHP bridge.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/ api-proxy.php [L]
